<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon Condition="Exists('icon.ico')">icon.ico</ApplicationIcon>

		<!-- Assembly & Package Metadata -->
		<AssemblyTitle>ROCHEFORT 6000 // PACIFIC WAR ROOM INTELLIGENCE SYSTEM</AssemblyTitle>
		<Product>WITP-CIC-ROCHEFORT</Product>
		<Description>ROCHEFORT 6000 Pacific War Room Combat Information Center and Intelligence Engine for War in the Pacific: Admiral's Edition.</Description>
		<Company>Station Hypo // WitP-CIC</Company>
		<Authors>WitP-CIC Team</Authors>
		<Version>0.03.0</Version>
		<AssemblyVersion>0.03.0.0</AssemblyVersion>
		<FileVersion>0.03.0.0</FileVersion>

		<!-- Publishing & Performance Optimizations -->
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<SatelliteResourceLanguages>none</SatelliteResourceLanguages>
		<Deterministic>true</Deterministic>
		<EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup Condition="Exists('icon.png')">
		<Resource Include="icon.png" />
	</ItemGroup>

	<ItemGroup Condition="Exists('icon.ico')">
		<Resource Include="icon.ico" />
	</ItemGroup>

	<ItemGroup Condition="Exists('assets/rochefort_lowres.png')">
		<Resource Include="assets/rochefort_lowres.png" />
	</ItemGroup>

	<ItemGroup Condition="Exists('assets/ugaki_lowres.png')">
		<Resource Include="assets/ugaki_lowres.png" />
	</ItemGroup>

	<ItemGroup>
		<None Update="text\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<None Update="sample_data\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<None Update="assets\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="tests\**\*.*" />
		<None Remove="tests\**\*.*" />
	</ItemGroup>

</Project>

